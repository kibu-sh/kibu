kibugen_ts -cwd $WORK/src/backend/ -out $WORK/src/backend/gen/ ./...
exists $WORK/src/backend/healthv1/healthv1.gen.ts
grep 'export function createService' $WORK/src/backend/healthv1/healthv1.gen.ts
