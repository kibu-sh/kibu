kibugen_ts -cwd $WORK/src/backend/ -out $WORK/src/backend/gen/ ./...
cmp $WORK/exp/healthv1.gen.ts $WORK/src/backend/healthv1/healthv1.gen.ts

-- src/go.mod --
module github.com/example/module

-- src/backend/healthv1/health.go --
package healthv1

import "context"

type CheckRequest struct {
	Name string `json:"name"`
}

type CheckResponse struct {
	Status string `json:"status"`
}

//kibu:service
type Service interface {
	//kibu:service:method method=GET path=/health/check
	Check(ctx context.Context, req *CheckRequest) (res *CheckResponse, err error)
}

-- exp/healthv1.gen.ts --
import type { HTTPClient } from './client'

export type CheckRequest = {
  name: string
}

export type CheckResponse = {
  status: string
}

export function createService(c: HTTPClient) {
  return {
    async check(req: CheckRequest): Promise<CheckResponse> {
      return c.request({
        method: 'GET',
        pathname: '/health/check',
        data: req,
      })
    },
  }
}
