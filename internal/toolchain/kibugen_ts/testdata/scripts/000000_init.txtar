-- src/backend/healthv1/health.go --
package healthv1

import (
	"context"
	"github.com/google/uuid"
)

type CheckRequest struct {
	Name string `json:"name"`
	ID   uuid.UUID `json:"id"`
}

type CheckResponse struct {
	Status string `json:"status"`
	UUID   uuid.UUID `json:"uuid"`
}

//kibu:service
type Service interface {
	//kibu:service:method method=GET path=/health/check
	Check(ctx context.Context, req CheckRequest) (res CheckResponse, err error)

	//kibu:service:method
	CheckNoDecoratorOptions(ctx context.Context, req CheckRequest) (res CheckResponse, err error)
}

-- exp/healthv1.gen.ts --
import type { HTTPClient } from './client'

type CheckRequest = {
  name: string
  id: string
}

type CheckResponse = {
  status: string
  uuid: string
}

function createService(c: HTTPClient) {
  return {
    async check(req: CheckRequest): Promise<CheckResponse> {
      return c.request({
        method: 'GET',
        pathname: '/health/check',
        data: req,
      })
    },
    async checkNoDecoratorOptions(req: CheckRequest): Promise<CheckResponse> {
      return c.request({
        method: 'POST',
        pathname: '/healthv1/Service/CheckNoDecoratorOptions',
        data: req,
      })
    },
  }
}

export const healthv1 = {
  createService,
}
