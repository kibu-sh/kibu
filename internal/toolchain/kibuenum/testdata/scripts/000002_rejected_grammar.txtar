# Each package isolates one unsupported declaration. Nothing here is executed.
! kibuenum $WORK/src ./...
cmp result.txt empty.txt
cmp diagnostics.txt expected-diagnostics.txt
grep 'Label must be a compile-time string constant' diagnostics.txt
grep 'Description must be a compile-time string constant' diagnostics.txt
grep 'first selected as A' diagnostics.txt
grep 'first declaration at' diagnostics.txt
grep 'exact enum type' diagnostics.txt
grep 'enums.go:[0-9]+:[0-9]+' diagnostics.txt

-- src/dynamic_metadata/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

func label() string { panic("must never execute") }
var S = enum.Define[E]([]enum.Member[E]{{Value: A, Label: label()}})
-- src/dynamic_description/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var desc = "desc"
var S = enum.Define[E]([]enum.Member[E]{{Value: A, Description: desc}})
-- src/variable_value/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var V E = A
var S = enum.Define[E]([]enum.Member[E]{{Value: V}})
-- src/untyped_constant/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

const U = "a"
var S = enum.Define[E]([]enum.Member[E]{{Value: U}})
