package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{{Value: "a"}})
-- src/conversion_value/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{{Value: E("a")}})
-- src/missing_value/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{{Label: "a"}})
-- src/duplicate_wire/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

const B E = A
var S = enum.Define[E]([]enum.Member[E]{{Value: A}, {Value: B}})
-- src/duplicate_declaration/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{{Value: A}})
var T = enum.Define[E]([]enum.Member[E]{{Value: A}})
-- src/conflicting_declaration/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{{Value: A}})
var T = enum.Define[E]([]enum.Member[E]{})
-- src/inferred_type/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define([]enum.Member[E]{{Value: A}})
-- src/slice_variable/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var M = []enum.Member[E]{{Value: A}}
var S = enum.Define[E](M)
-- src/slice_function/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

func members() []enum.Member[E] { panic("must never execute") }
var S = enum.Define[E](members())
-- src/member_variable/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var M = enum.Member[E]{Value: A}
var S = enum.Define[E]([]enum.Member[E]{M})
-- src/indexed_slice/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{2: {Value: A}})
-- src/unkeyed_member/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[E]([]enum.Member[E]{{A, "a", "b"}})
-- src/local_call/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

func f() { _ = enum.Define[E]([]enum.Member[E]{{Value: A}}) }
-- src/nested_call/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

func wrap(s enum.Set[E]) enum.Set[E] { return s }
var S = wrap(enum.Define[E]([]enum.Member[E]{{Value: A}}))
-- src/blank_declaration/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var _ = enum.Define[E]([]enum.Member[E]{{Value: A}})
-- src/multiple_bindings/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S, T = enum.Define[E]([]enum.Member[E]{{Value: A}}), 1
-- src/builtin_type/enums.go --
package sample

import enum "github.com/kibu-sh/kibu/pkg/enum/experimental"

type E string
const A E = "a"

var S = enum.Define[string]([]enum.Member[string]{{Value: "a"}})

