type activitiesProxy struct{}

func (a *activitiesProxy) Login(ctx workflow.Context, req LoginRequest, mods ...temporal.ActivityOptionFunc) (res security.Scope, err error) {
	return a.LoginAsync(ctx, req, mods...).Get(ctx)
}
func (a *activitiesProxy) LoginAsync(ctx workflow.Context, req LoginRequest, mods ...temporal.ActivityOptionFunc) temporal.Future[security.Scope] {
	options := temporal.NewActivityOptionsBuilder().WithStartToCloseTimeout(time.Second * 30).WithTaskQueue(packageName).WithProvidersWhenSupported(req).WithOptions(mods...).Build()
	ctx = workflow.WithActivityOptions(ctx, options)
	future := workflow.ExecuteActivity(ctx, activitiesLoginName, req)
	return temporal.NewFuture[security.Scope](future)
