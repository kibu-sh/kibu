-- src/healthv1/healthv1.spec.go --
package healthv1

import (
	"context"
	"github.com/kibu-sh/kibu/pkg/transport"
)

type CheckRequest struct {
	Name string `json:"name"`
}

type CheckResponse struct {
	Status string `json:"status"`
}

//kibu:service
type Service interface {
	// Standard endpoint with request/response
	//kibu:service:method method=GET path=/health/check
	Check(ctx context.Context, req CheckRequest) (res CheckResponse, err error)

	// Raw endpoint with transport.Context
	//kibu:service:method mode=raw path=/health/raw
	RawHandler(tctx transport.Context) error
}

